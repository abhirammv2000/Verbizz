# Copy to backend/.env (git ignores it). Used by the Makefile and by running server.py directly.
# docker compose does not read this file: it uses the .env at the repository root.
DOCKER_USERNAME=your-dockerhub-username
JWT_SECRET_KEY=change-me
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
